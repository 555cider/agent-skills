{
  "description": "agent-memory recall and capture for Claude Code; Codex reads hooks.codex.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/agent-memory/bin/agent-memory\" hook --harness claude --event user_prompt",
            "timeout": 10,
            "statusMessage": "Agent Memory user_prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/agent-memory/bin/agent-memory\" hook --harness claude --event assistant_stop",
            "timeout": 15,
            "statusMessage": "Agent Memory assistant_stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/skills/agent-memory/bin/agent-memory\" hook --harness claude --event session_end",
            "timeout": 3,
            "statusMessage": "Agent Memory session_end"
          }
        ]
      }
    ]
  }
}
