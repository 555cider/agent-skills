{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOM Picker v2 fix result",
  "type": "object",
  "required": [
    "status",
    "confidence",
    "diagnosis",
    "authorization",
    "candidates",
    "changes",
    "verification",
    "warnings"
  ],
  "properties": {
    "status": {
      "enum": ["applied_verified", "no_change", "review_required", "blocked"]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "diagnosis": { "type": "string" },
    "authorization": {
      "type": "object",
      "required": ["channel", "eligible"],
      "properties": {
        "channel": { "enum": ["trusted-chat", "isolated-picker", "none"] },
        "eligible": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "score", "signalFamilies"],
        "properties": {
          "path": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "signalFamilies": { "type": "array", "items": { "type": "string" } },
          "signals": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string" },
          "reason": { "type": "string" },
          "diff": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["targetReacquired", "assertions", "passed"],
      "properties": {
        "targetReacquired": { "type": "boolean" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric", "operator", "expected", "passed"],
            "properties": {
              "pickIndex": { "type": "integer", "minimum": 0 },
              "metric": { "type": "string" },
              "operator": { "enum": ["==", "!=", ">", ">=", "<", "<=", "contains", "matches"] },
              "expected": {},
              "actual": {},
              "passed": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "beforeScreenshot": { "type": ["string", "null"] },
        "afterScreenshot": { "type": ["string", "null"] },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
