{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dom-picker input",
  "type": "object",
  "required": [
    "instruction",
    "page",
    "element",
    "candidateFiles"
  ],
  "properties": {
    "instruction": {
      "type": "string",
      "description": "What the user wants fixed about the selected element."
    },
    "page": {
      "type": "object",
      "required": ["url", "title", "viewport"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "viewport": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "devicePixelRatio": { "type": "number" }
          }
        }
      }
    },
    "element": {
      "type": "object",
      "description": "PickedElement payload from assets/element-picker.js.",
      "required": ["selector", "tagName"],
      "properties": {
        "selector": { "type": "string" },
        "tagName": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "className": { "type": ["string", "null"] },
        "ariaLabel": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "outerHTML": { "type": "string" },
        "parentHTML": { "type": ["string", "null"] },
        "rect": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "computedStyle": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "nearbyText": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resolvedFromLeaf": {
          "type": ["string", "null"],
          "description": "Tag of the original leaf click when the pick was promoted to an ancestor; null otherwise."
        },
        "kind": { "type": "string", "description": "Human descriptor tag of the resolved element." },
        "detail": { "type": "string", "description": "Short descriptor (aria-label / data-testid / id / text)." },
        "label": { "type": "string", "description": "Display label combining kind and detail." }
      }
    },
    "screenshot": {
      "type": "string",
      "description": "Optional base64 or data URL screenshot of the selected element / page."
    },
    "candidateFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content", "reason", "score"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "reason": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "requests": {
      "type": "array",
      "description": "Batch of fix requests drained from the picker queue (window.__s2p.queue). Present when the agent processes several submissions together; each item pairs an instruction with the element(s) it was submitted against. The single top-level instruction/element still describe one request for the non-batch path.",
      "items": {
        "type": "object",
        "required": ["instruction"],
        "properties": {
          "instruction": { "type": "string" },
          "seq": { "type": "number", "description": "Monotonic submission order from the picker." },
          "picks": {
            "type": "array",
            "description": "Lightweight pick descriptors as enqueued by the picker (enrich via snapshot before patching).",
            "items": {
              "type": "object",
              "properties": {
                "selector": { "type": "string" },
                "tagName": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
