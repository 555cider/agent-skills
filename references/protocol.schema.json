{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOM Picker v2 event",
  "type": "object",
  "required": ["protocolVersion", "protocolRevision", "event", "payload"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "protocolRevision": { "const": 1 },
    "event": {
      "type": "string",
      "enum": [
        "ready",
        "runtime_ready",
        "queue",
        "claim",
        "request_status",
        "cancel_request",
        "selection_command",
        "targets",
        "candidates",
        "navigation",
        "pick",
        "request",
        "snapshot",
        "verification",
        "disconnected",
        "reconnected",
        "reloaded",
        "rejected",
        "destroyed",
        "stopped",
        "error"
      ]
    },
    "sessionId": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["durable-fifo", "status-sync", "cancel-request", "frame-selection-v2"] },
      "uniqueItems": true
    },
    "target": { "$ref": "#/definitions/target" },
    "payload": { "type": "object" }
  },
  "additionalProperties": true,
  "definitions": {
    "target": {
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "allowedOrigin": { "type": "string" },
        "debugPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": true
    },
    "locator": {
      "type": "object",
      "required": ["strategy", "value", "unique", "strength"],
      "properties": {
        "strategy": { "type": "string" },
        "value": { "type": "string" },
        "selector": { "type": ["string", "null"] },
        "unique": { "type": "boolean" },
        "strength": { "enum": ["high", "medium", "low"] }
      }
    },
    "pick": {
      "type": "object",
      "required": ["pickId", "locators", "tagName", "rect", "computedStyle", "metrics"],
      "properties": {
        "pickId": { "type": "string" },
        "selector": { "type": ["string", "null"] },
        "locators": { "type": "array", "items": { "$ref": "#/definitions/locator" } },
        "tagName": { "type": "string" },
        "role": { "type": ["string", "null"] },
        "accessibleName": { "type": "string" },
        "attributes": { "type": "object" },
        "text": { "type": "string" },
        "rect": { "type": "object" },
        "computedStyle": { "type": "object" },
        "metrics": { "type": "object" },
        "sourceHints": { "type": "object" },
        "frameId": { "type": "string" },
        "canWiden": { "type": "boolean" },
        "canNarrow": { "type": "boolean" },
        "scopeTrail": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "requestPayload": {
      "type": "object",
      "required": ["requestId", "instruction", "picks", "provenance"],
      "properties": {
        "requestId": { "type": "string" },
        "instruction": { "type": "string", "minLength": 1 },
        "queueSequence": { "type": "integer", "minimum": 1 },
        "picks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pick" } },
        "provenance": {
          "type": "object",
          "required": ["channel", "trustedUserEvent"],
          "properties": {
            "channel": { "enum": ["isolated-picker", "trusted-chat", "fallback-page"] },
            "trustedUserEvent": { "type": "boolean" },
            "trusted": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "directory": { "type": ["string", "null"] },
            "beforeScreenshot": { "type": ["string", "null"] },
            "beforeTargetCrops": { "type": "array", "items": { "type": ["string", "null"] } },
            "pickerHidden": { "type": "boolean" },
            "cropPadding": { "const": 24 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "requestState": {
      "enum": [
        "queued",
        "claimed",
        "locating",
        "editing",
        "verifying",
        "cancel_requested",
        "applied_verified",
        "no_change",
        "cancelled",
        "review_required",
        "blocked"
      ]
    },
    "requestStatus": {
      "type": "object",
      "required": ["state", "message"],
      "properties": {
        "state": { "$ref": "#/definitions/requestState" },
        "message": { "type": "string", "maxLength": 240 },
        "resultPath": { "type": ["string", "null"] },
        "cancellation": {
          "type": "object",
          "required": ["requested", "changesRemain", "rollbackCompleted"],
          "properties": {
            "requested": { "const": true },
            "changesRemain": { "const": false },
            "rollbackCompleted": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
