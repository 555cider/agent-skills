#!/usr/bin/env bash
# agent-memory-managed-launcher-v2
set -euo pipefail

skill_root="$HOME/.agents/skills/agent-memory"
if [ -x "$skill_root/.venv/bin/python" ]; then
  python_bin="$skill_root/.venv/bin/python"
elif [ -x "$skill_root/.venv/Scripts/python.exe" ]; then
  python_bin="$skill_root/.venv/Scripts/python.exe"
else
  python_bin="python3"
fi
exec "$python_bin" "$skill_root/scripts/memory.py" "$@"
