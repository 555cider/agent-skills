{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOM Picker v2 fix result",
  "type": "object",
  "required": [
    "status",
    "confidence",
    "diagnosis",
    "authorization",
    "candidates",
    "changes",
    "verification",
    "warnings"
  ],
  "properties": {
    "status": {
      "enum": ["applied_verified", "no_change", "cancelled", "review_required", "blocked"]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "diagnosis": { "type": "string" },
    "authorization": {
      "type": "object",
      "required": ["channel", "eligible"],
      "properties": {
        "channel": { "enum": ["trusted-chat", "isolated-picker", "none"] },
        "eligible": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "score", "signalFamilies"],
        "properties": {
          "path": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "signalFamilies": { "type": "array", "items": { "type": "string" } },
          "signals": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string" },
          "reason": { "type": "string" },
          "diff": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "cancellation": {
      "type": "object",
      "required": ["requested", "changesRemain", "rollbackCompleted"],
      "properties": {
        "requested": { "const": true },
        "changesRemain": { "type": "boolean" },
        "rollbackCompleted": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["targetReacquired", "assertions", "passed"],
      "properties": {
        "targetReacquired": { "type": "boolean" },
        "assertions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["metric", "operator", "expected", "passed"],
            "properties": {
              "pickIndex": { "type": "integer", "minimum": 0 },
              "metric": { "type": "string" },
              "operator": { "enum": ["==", "!=", ">", ">=", "<", "<=", "contains", "matches"] },
              "expected": {},
              "actual": {},
              "passed": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "beforeScreenshot": { "type": ["string", "null"] },
        "afterScreenshot": { "type": ["string", "null"] },
        "beforeTargetCrops": { "type": "array", "items": { "type": ["string", "null"] } },
        "afterTargetCrops": { "type": "array", "items": { "type": ["string", "null"] } },
        "pickerHidden": { "type": "boolean" },
        "cropPadding": { "const": 24 },
        "reacquisition": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["matchedLocator", "identityEvidence", "reacquisitionConfidence"],
            "properties": {
              "matchedLocator": { "type": ["object", "null"] },
              "identityEvidence": { "type": "object" },
              "reacquisitionConfidence": { "enum": ["none", "medium", "high"] }
            },
            "additionalProperties": true
          }
        },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "applied_verified" } } },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "targetReacquired": { "const": true },
              "passed": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "cancelled" } } },
      "then": {
        "required": ["cancellation"],
        "properties": {
          "cancellation": {
            "properties": { "changesRemain": { "const": false } }
          }
        },
        "anyOf": [
          { "properties": { "changes": { "maxItems": 0 } } },
          { "properties": { "cancellation": { "properties": { "rollbackCompleted": { "const": true } } } } }
        ]
      }
    }
  ],
  "additionalProperties": false
}
