{
  "_comment": "Human-readable contract for scripts/plan-graph.py. run.sh is the executable source of truth and hardcodes these cases; this file documents what each one asserts. expectExit is the process exit code; grepStdout/grepStderr are substrings/patterns that must appear; noGrep must NOT appear; fileContains checks the named file after the run.",
  "cases": [
    { "case": "normal-show", "fixture": "normal", "args": ["--show"], "expectExit": 0, "grepStdout": ["[5] Migration plan", "[1] Auth/session ↑", "[7] Legacy approach (dropped)", "[1] ➔ [3] ➔ [5]"], "note": "golden tree + shared-base repeat marker + dropped inline + critical path" },
    { "case": "normal-check", "fixture": "normal", "args": [], "expectExit": 0, "grepStdout": ["OK plan graph"], "noGrepStderr": ["ERROR=", "WARN="], "note": "fully clean after setup --fix populates frontmatter" },
    { "case": "normal-json", "fixture": "normal", "args": ["--json"], "expectExit": 0, "grepStdout": ["\"status\": \"OK\"", "\"errors\": []"], "note": "check/--fix JSON object shape" },
    { "case": "normal-show-json", "fixture": "normal", "args": ["--show", "--json"], "expectExit": 0, "grepStdout": ["\"critical_path\"", "\"roadmap\""], "note": "--show JSON adds tree/roadmap/excluded/critical_path" },
    { "case": "single-show", "fixture": "single", "args": ["--show"], "expectExit": 0, "noGrepStdout": ["Critical Path"], "note": "depth>1 gate: a lone node prints no critical path" },
    { "case": "cycle-show", "fixture": "cycle", "args": ["--show"], "expectExit": 0, "grepStdout": ["[1] alpha", "[2] beta", "(cycle, excluded from roadmap)"], "noGrep": ["Traceback"], "note": "no RecursionError; all nodes listed" },
    { "case": "cycle-check", "fixture": "cycle", "args": [], "expectExit": 1, "grepStderr": ["ERROR=cycle detected: 1 -> 2 -> 1", "FAIL plan graph"] },
    { "case": "legacy-check-pre", "fixture": "legacy", "args": [], "expectExit": 0, "grepStderr": ["WARN=missing frontmatter in .agents/plan/auth.md"], "grepStdout": ["OK plan graph"], "noGrepStderr": ["ERROR="] },
    { "case": "legacy-fix", "fixture": "legacy", "args": ["--fix"], "expectExit": 0, "grepStdout": ["CHANGE=add-frontmatter 1 .agents/plan/auth.md"], "fileContains": { "auth.md": ["^id: 1", "summary: \"Auth plan\""] } },
    { "case": "legacy-check-post", "fixture": "legacy", "args": [], "expectExit": 0, "grepStdout": ["OK plan graph"], "noGrepStderr": ["WARN=missing frontmatter"] },
    { "case": "comment-check", "fixture": "comment", "args": [], "expectExit": 0, "noGrepStderr": ["mismatch", "ERROR="], "note": "inline # comment in frontmatter tolerated" },
    { "case": "comment-hash-check", "fixture": "comment-hash", "args": [], "expectExit": 0, "noGrepStderr": ["mismatch"], "note": "# inside a quoted value is not stripped" },
    { "case": "done-fix", "fixture": "done", "args": ["--fix"], "expectExit": 0, "grepStdout": ["CHANGE=add-frontmatter 2 dep.md"], "fileContains": { "dep.md": ["x: \"done\""] } },
    { "case": "dropped-fix", "fixture": "dropped", "args": ["--fix"], "expectExit": 0, "grepStdout": ["CHANGE=sync-frontmatter 1 legacy.md"], "fileContains": { "legacy.md": ["x: \"dropped\""] }, "note": "sync rewrites a wrong existing x" },
    { "case": "missingnode-check", "fixture": "missingnode", "args": [], "expectExit": 0, "grepStderr": ["WARN=1 file is missing"], "noGrepStderr": ["frontmatter mismatch"] },
    { "case": "sync-fix", "fixture": "sync", "args": ["--fix"], "expectExit": 0, "grepStdout": ["CHANGE=sync-frontmatter 1 .agents/plan/auth.md summary,x"], "noGrepStdout": ["summary, x"], "note": "single comma-joined token; blank line after --- preserved" },
    { "case": "readonly-fix", "fixture": "readonly", "args": ["--fix"], "expectExit": 1, "grepStderr": ["ERROR=failed to update frontmatter in auth.md", "FAIL plan graph"], "noGrep": ["Traceback"], "skipAsRoot": true },
    { "case": "dedup-fix", "fixture": "dedup", "args": ["--fix"], "expectExit": 0, "grepStdout": ["CHANGE=dedup 1"], "fileContains": { ".agents/plan/graph.yaml": ["1: [2]"] } },
    { "case": "badparse-check", "fixture": "badparse", "args": [], "expectExit": 2, "grepStderr": ["ERROR=parse:"] },
    { "case": "badparse-fix", "fixture": "badparse", "args": ["--fix"], "expectExit": 2, "note": "graph.yaml left byte-identical (cmp -s)" },
    { "case": "missinggraph-check", "fixture": "missinggraph", "args": [], "expectExit": 1, "grepStderr": ["graph file does not exist"] },
    { "case": "missinggraph-fix", "fixture": "missinggraph", "args": ["--fix"], "expectExit": 0, "fileContains": { ".agents/plan/graph.yaml": ["next: 1"] } },
    { "case": "bomplan-fix", "fixture": "bomplan", "args": ["--fix"], "expectExit": 0, "noGrepStdout": ["CHANGE=add-frontmatter 1"], "note": "BOM'd plan file: existing frontmatter recognized, not duplicated (exactly one 'id: 1')" },
    { "case": "bomgraph-check", "fixture": "bomgraph", "args": [], "expectExit": 0, "grepStdout": ["OK plan graph"], "noGrepStderr": ["ERROR=parse"], "note": "BOM'd graph.yaml still parses" },
    { "case": "dupbase-show", "fixture": "dupbase", "args": ["--show"], "expectExit": 0, "grepStdout": ["2. [2] beta"], "noGrepStdout": ["excluded from roadmap"], "note": "repeated base does not drop the dependent as a phantom cycle" },
    { "case": "traversal-fix", "fixture": "traversal", "args": ["--fix"], "expectExit": 1, "note": "outside ../escape file left untouched (no frontmatter written outside root)" },
    { "case": "forestrepeat-show", "fixture": "forestrepeat", "args": ["--show"], "expectExit": 0, "noGrepStdout": ["^[2] beta as a top-level line"], "note": "a cycle/forest node is printed once, not twice" },
    { "case": "lockfresh-fix", "fixture": "lockfresh", "args": ["--fix"], "expectExit": 1, "grepStderr": ["ERROR=graph locked by another process"], "note": "foreign fresh lock blocks and is NOT deleted (~3s retry)" },
    { "case": "lockstale-fix", "fixture": "lockstale", "args": ["--fix"], "expectExit": 0, "grepStdout": ["OK plan graph"], "note": "stale (>10s) lock overtaken; our lock released on exit" }
  ]
}
