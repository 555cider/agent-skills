{
  "_comment": "Full ui-audit v2 defaults. Copy to your project as audit-config.json and override routes/states/waitForSelector; thresholds rarely need changing.",
  "routes": ["/"],
  "viewports": [
    { "name": "mobile", "width": 390, "height": 844, "isMobile": true, "dpr": 3 },
    { "name": "desktop", "width": 1280, "height": 900, "isMobile": false, "dpr": 1 }
  ],
  "themes": ["light", "dark"],
  "states": ["default"],
  "adaptations": ["zoom-200", "reflow-320"],
  "workers": 2,
  "scrollPositions": ["top", "bottom"],
  "settleMs": 400,
  "waitForSelector": null,
  "apiMockPattern": "**/api/**",
  "stateMocks": {},
  "stateSetups": {},
  "themeInitScripts": {},
  "keyboardProbe": { "maxSteps": 120, "settleMs": 0 },
  "hoverProbe": { "maxTargets": 80, "settleMs": 0, "maxWaitMs": 250, "denseGapPx": 12 },
  "baseline": [],
  "auditConfig": {
    "contrast": { "normal": 4.5, "large": 3.0, "washedOut": 1.3, "placeholderFail": 3.0, "nonText": 3.0, "colorCue": 3.0 },
    "tap": { "fail": 24, "risk": 44, "crowdGap": 8 },
    "cls": { "risk": 0.1, "fail": 0.25 },
    "polish": { "bodyTextMinChars": 40, "bodyTextMinLines": 3, "bodyLineHeight": 1.5 },
    "layout": { "loneNarrowWidth": 180, "maxButtonsInRow": 4 },
    "authedNavWords": ["my", "account", "profile", "mypage", "마이", "계정", "프로필", "내정보"],
    "whitelist": [],
    "maxFindingsPerRule": 60,
    "maxPolish": 15
  }
}
